<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.tamacat.monitor</groupId>
    <artifactId>tamacat-monitor-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tamacat-monitor-admin</artifactId>
  <packaging>war</packaging>
  <name>tamacat-monitor-admin</name>
  <description>Servlet / JSP web application, deployed to tamacat-httpd 1.7 webapps/ as monitor.war.</description>

  <dependencies>
    <dependency>
      <groupId>org.tamacat.monitor</groupId>
      <artifactId>tamacat-monitor-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.tamacat.monitor</groupId>
      <artifactId>tamacat-monitor-zabbix</artifactId>
    </dependency>
    <!-- build order only: tamacat-monitor-ui builds dist/ before the WAR is packaged -->
    <dependency>
      <groupId>org.tamacat.monitor</groupId>
      <artifactId>tamacat-monitor-ui</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>provided</scope>
    </dependency>

    <!-- JSON (Jakarta JSON-P + Parsson) -->
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.parsson</groupId>
      <artifactId>parsson</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JSTL (Tomcat does not bundle it) -->
    <dependency>
      <groupId>jakarta.servlet.jsp.jstl</groupId>
      <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
      <exclusions>
        <!-- EL is provided by Tomcat -->
        <exclusion>
          <groupId>jakarta.el</groupId>
          <artifactId>jakarta.el-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.glassfish.web</groupId>
      <artifactId>jakarta.servlet.jsp.jstl</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JDBC driver for the central DB and Zabbix DB (MySQL) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
      <exclusions>
        <!-- only needed for the X DevAPI; JDBC does not use it -->
        <exclusion>
          <groupId>com.google.protobuf</groupId>
          <artifactId>protobuf-java</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!--
      Provided by the container (tamacat-httpd 1.7 + Tomcat Embedded 11.0.29).
      slf4j-api and tamacat-logging are on the tamacat-httpd system classpath; bundling them
      in the WAR would create a second SLF4J instance in the webapp class loader.
    -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet.jsp</groupId>
      <artifactId>jakarta.servlet.jsp-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>monitor</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
          <webResources>
            <!-- Cloudscape page bundles built by tamacat-monitor-ui (served under /static) -->
            <resource>
              <directory>../tamacat-monitor-ui/dist</directory>
              <excludes>
                <exclude>meta.json</exclude>
              </excludes>
            </resource>
          </webResources>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
